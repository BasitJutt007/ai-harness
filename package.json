{
  "name": "sf-ai-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A provider-agnostic agent harness that governs greenfield and brownfield TypeScript REST API work.",
  "type": "module",
  "bin": {
    "harness": "bin/harness.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && node bin/harness.mjs doctor",
    "harness": "node bin/harness.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "verify": "npm run typecheck && npm test"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "express": "5.2.1",
    "js-tiktoken": "1.0.21",
    "openai": "7.27.0",
    "picomatch": "4.0.7",
    "pluralize": "8.0.0",
    "tinyglobby": "0.2.17",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/picomatch": "4.0.3",
    "@types/pluralize": "0.0.33",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "vitest": "5.0.3"
  }
}
